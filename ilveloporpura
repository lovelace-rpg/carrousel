  /* =========================
     UTILS
  ========================= */

  const seededRandom = s => {
    let x = Math.sin(s * 9999) * 43758.5453;
    return x - Math.floor(x);
  };

  const pick = (list, seed) => {
    const total = list.reduce((s, i) => s + i.chance, 0);
    let r = seededRandom(seed) * total, sum = 0;
    for (let i = 0; i < list.length; i++) {
      sum += list[i].chance;
      if (r <= sum) return list[i].text;
    }
    return list[list.length - 1].text;
  };

  const computeSeed = str => {
    let s = 0;
    for (let i = 0; i < str.length; i++) s += str.charCodeAt(i);
    return s;
  };

  const getOptionsByTranche = (tranches, amount) => {
    const tranche = tranches.find(t => amount >= t.min && amount <= t.max);
    return tranche ? tranche.options : tranches[tranches.length - 1].options;
  };

  /* =========================
     TEMPLATES
  ========================= */

  const TEMPLATES = {

    don: (sacrifice, result) => `
      <div class="my-don-result">
        <h7>Sacrifice</h7> &nbsp; Don &nbsp; - &nbsp; ${sacrifice}<br>
        <h7>Résultat</h7> &nbsp; ${result}
      </div>
    `,

    points: (sacrifice, result) => `
      <div class="my-points-result">
        <h7>Sacrifice</h7> &nbsp; Points &nbsp; - &nbsp; ${sacrifice}<br>
        <h7>Résultat</h7> &nbsp; ${result}
      </div>
    `,

    aureus: (sacrifice, result) => `
      <div class="my-bet-result">
        <h7>Sacrifice</h7> &nbsp; Aureus &nbsp; - &nbsp; ${sacrifice}<br>
        <h7>Résultat</h7> &nbsp; ${result}
      </div>
    `,

    malediction: (aureus, target, result) => `
      <div class="my-malediction-result">
        <h7>Aureus sacrifiés</h7> &nbsp; ${aureus}<br>
        <h7>Cible de la malédiction</h7> &nbsp; ${target}<br>
        <h7>Résultat</h7> &nbsp; ${result}
      </div>
    `,

    benediction: (aureus, target, result) => `
      <div class="my-benediction-result">
        <h7>Aureus sacrifiés</h7> &nbsp; ${aureus}<br>
        <h7>Cible de la bénédiction</h7> &nbsp; ${target}<br>
        <h7>Résultat</h7> &nbsp; ${result}
      </div>
    `

  };

  /* =========================
     CORE
  ========================= */

  function processPost(post) {
    try {

      const content = post.querySelector(CONFIG.contentSelector);
      if (!content) return;

      let html = content.innerHTML;

      if (!html.includes("[sacrifice") &&
          !html.includes("[malediction") &&
          !html.includes("[benediction") &&
          !html.includes("[random_event]")) return;

      const postId = parseInt(post.id.replace(/\D/g, "")) || 0;

      html = html.replace(/\[\s*random_event\s*\]/gi, () => {
        return pick(randomEvents, postId);
      });

      html = html.replace(/\[\s*sacrifice\s+aureus\s+(\d+)\s*\]/gi, (_, betStr) => {
        const bet = +betStr.trim();
        const rand = seededRandom(postId + 1);
        const gain = rand < 0.4 ? bet * 2 : rand < 0.8 ? 0 : bet * 5;
        const text = rand < 0.4 ? "Faveur divine." : rand < 0.8 ? "Perte totale." : "Miracle.";
        return TEMPLATES.aureus(`${bet} aureus`, `${text} (+${gain})`);
      });

      html = html.replace(/\[\s*sacrifice\s+don\s*(.*?)\s*\]/gi, (_, txt) => {
        txt = (txt || "").trim();
        const seed = computeSeed(String(postId) + txt);
        return TEMPLATES.don(txt || "Offrande", pick(sacrificeDonOptions, seed));
      });

      html = html.replace(/\[\s*sacrifice\s+points\s*(.*?)\s*\]/gi, (_, txt) => {
        txt = (txt || "").trim();
        const seed = computeSeed(String(postId) + txt);
        return TEMPLATES.points(txt || "Points", pick(sacrificePointsOptions, seed));
      });

      html = html.replace(/\[\s*malediction\s+(.+?)\s+aureus\s+(\d+)\s*\]/gi, (_, target, amount) => {
        target = target.trim();
        amount = amount.trim();
        const seed = computeSeed(String(postId) + target.toLowerCase() + amount);
        const options = getOptionsByTranche(maledictionsTranches, +amount);
        return TEMPLATES.malediction(amount, target, pick(options, seed));
      });

      html = html.replace(/\[\s*benediction\s+(.+?)\s+aureus\s+(\d+)\s*\]/gi, (_, target, amount) => {
        target = target.trim();
        amount = amount.trim();
        const seed = computeSeed(String(postId) + target.toLowerCase() + amount);
        const options = getOptionsByTranche(benedictionsTranches, +amount);
        return TEMPLATES.benediction(amount, target, pick(options, seed));
      });

      content.innerHTML = html;

      if (post.id === "preview") {
        const warning = document.createElement("div");
        warning.className = "my-preview-warning";
        warning.innerHTML = "<i><strong>Attention résultat temporaire</strong> — Le résultat final sera mis à jour à la publication du post. Après la publication du post merci de ne pas modifier le contenu entre les parenthèses.</i>";
        content.appendChild(warning);
      }

    } catch(e) {
      console.error("Erreur processPost:", e);
    }
  }

  /* =========================
     SCAN
  ========================= */

  const scan = () => {
    document.querySelectorAll(CONFIG.postSelector).forEach(processPost);
  };

  /* =========================
     INIT
  ========================= */

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scan);
  } else {
    scan();
  }

})();
